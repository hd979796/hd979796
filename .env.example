# ===== 알리고 문자 서비스 설정 =====
# 알리고(smartsms.aligo.in) 로그인 → [문자API] → [신청/인증] 에서 확인
ALIGO_API_KEY=
ALIGO_USER_ID=
# 알리고에 등록·인증된 발신번호 (예: 0312345678)
ALIGO_SENDER=

# Y = 테스트모드(실제 발송·차감 없음), N = 실제 발송
ALIGO_TEST_MODE=Y

# ===== 발송 옵션 =====
# Y = 마케팅 수신동의가 유효한 고객에게만 발송
REQUIRE_MARKETING_CONSENT=Y
# 장문(LMS)일 때 제목
SMS_TITLE=생일 축하드립니다
# 고객 명단 파일 (이 폴더 기준 경로)
CUSTOMER_FILE=data/customers.xlsx

# 발송 테스트(test_send.bat)용 명단 - 이 명단 전원에게 생일과 관계없이 발송
TEST_CUSTOMER_FILE=../생일축하 문자 발송 테스트 문서.xlsx
